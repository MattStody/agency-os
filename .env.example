# ── Database ───────────────────────────────────────────────────────────────
# Postgres connection for the app. On Supabase use the pooler URI
# (Project Settings → Database → Connection string → Transaction pooler).
# Local: docker compose up -d   →   postgres://postgres:postgres@localhost:5432/boldly_os
DATABASE_URL=postgres://postgres:postgres@localhost:5432/boldly_os

# ── Google sign-in (via Supabase Auth) ─────────────────────────────────────
# Supabase project settings (Project Settings → API). Leave blank to run with demo sign-in only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Configure the same client as the Google provider in Supabase Auth, with redirect
# URI https://<project-ref>.supabase.co/auth/v1/callback. Used to refresh Drive tokens.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Access ─────────────────────────────────────────────────────────────────
# Staff domain(s): anyone signing in with these is added as a team member.
ALLOWED_EMAIL_DOMAINS=boldlymedia.com
# Comma-separated emails that become admins on their first sign-in.
BOOTSTRAP_ADMIN_EMAILS=

# ── Demo sign-in (local + preview only; always off on Vercel production) ────
DEMO_LOGIN=true
# 32+ random characters, e.g. `openssl rand -base64 32`
AUTH_SECRET=
