# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Configure this same client as the Google provider in Supabase Auth settings,
# with redirect URI: https://your-project.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Reporting module -------------------------------------------------------
# Supermetrics is the connector layer: it delivers rows, we land + normalize
# them. Without these the sync route fails loudly rather than landing nothing.
SUPERMETRICS_API_KEY=your-supermetrics-api-key
SUPERMETRICS_TEAM_ID=your-supermetrics-team-id
# Override only if you're on a different Supermetrics API host/endpoint.
# SUPERMETRICS_API_URL=https://api.supermetrics.com/enterprise/v2/query/data/json

# Shared secret for /api/reporting/sync. Vercel Cron sends it automatically as
# `Authorization: Bearer $CRON_SECRET`; use the same value for manual re-runs.
CRON_SECRET=a-long-random-string
